{
  "name": "sentinel-x-research",
  "version": "0.1.0",
  "private": true,
  "description": "Sentinel-X AVR defensive vulnerability research framework for Rust, Noir, and Solana targets.",
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @sentinel-x/api --filter @sentinel-x/dashboard dev",
    "build": "pnpm -r --workspace-concurrency=1 build",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "check": "pnpm -r --workspace-concurrency=1 check",
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck",
    "pack:check": "pnpm --filter @sentinel-x/contracts pack:check && pnpm --filter @sentinel-x/agent pack:check"
  },
  "keywords": [
    "kinhold",
    "security",
    "bug-bounty",
    "avr",
    "defensive"
  ],
  "author": "Kinhold",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kinhold/sentinel-x-research.git"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
