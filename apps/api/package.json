{
  "name": "@sentinel-x/api",
  "version": "0.1.0",
  "private": true,
  "description": "Sentinel-X AVR HTTP API",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx --watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "pnpm run typecheck && pnpm run build && pnpm run test"
  },
  "dependencies": {
    "@sentinel-x/agent": "workspace:*",
    "@sentinel-x/contracts": "workspace:*",
    "@sentinel-x/storage": "workspace:*",
    "dotenv": "^17.3.1",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.16.5",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
